# ChainGuard — environment variables
# Copy this file to `.env.local` (Next.js) and never commit real secrets.
#
# All variables are optional unless noted. The application runs in local/demo
# mode without any of them configured.

# ---------------------------------------------------------------------------
# BACKEND CONNECTION
# ---------------------------------------------------------------------------

# URL of the running ChainGuard FastAPI backend.
# Required to enable live repository analysis (GitHub or ZIP).
# Example: http://localhost:8000
# CHAINGUARD_API_URL=http://localhost:8000

# Shared secret used by Next.js to authenticate calls to the FastAPI backend,
# and by FastAPI to authenticate the AI investigation callback from Next.js.
# Must be at least 24 characters. Generate with:
#   openssl rand -hex 32
# CHAINGUARD_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# AI INVESTIGATION
# ---------------------------------------------------------------------------

# AI model identifier passed to the Vercel AI SDK.
# Defaults to anthropic/claude-sonnet-5.
# CHAINGUARD_AI_MODEL=anthropic/claude-sonnet-5

# Your AI provider API key. Never exposed to the browser.
# For Anthropic: set ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=

# For OpenAI: set OPENAI_API_KEY
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# UPLOAD LIMITS
# ---------------------------------------------------------------------------

# Maximum ZIP upload size in megabytes (default 20, max 100).
# CHAINGUARD_MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# BACKEND-ONLY VARIABLES (set in the Python service environment, not here)
# ---------------------------------------------------------------------------

# CHAINGUARD_DATA_DIR=./.chainguard-data
# CHAINGUARD_MAX_EXTRACTED_MB=80
# CHAINGUARD_MAX_FILES=5000
# CHAINGUARD_MAX_SOLIDITY_FILES=150
# CHAINGUARD_SLITHER_TIMEOUT_S=180
# CHAINGUARD_AI_REASON_URL=http://localhost:3000/api/internal/reason
# CHAINGUARD_AI_TIMEOUT_S=120
# CHAINGUARD_ALLOWED_ORIGINS=http://localhost:3000
# GITHUB_TOKEN=   # Personal access token for private repo ingestion (optional)
